{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "toolbench.tool/1",
  "title": "Tool Bench tool block",
  "description": "The fields a tool file carries in <script type=\"application/json\" id=\"toolbench-tool\">, the same fields its card shows. The bench reads them on import and rewrites them, with a higher version, on every save.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "id", "name", "version"],
  "properties": {
    "format": { "const": "toolbench.tool/1" },
    "id": { "type": "string", "pattern": "^(TB:[a-z0-9][a-z0-9-]*|TL:[0-9]+)$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "maxLength": 400 },
    "category": { "type": "string", "maxLength": 40 },
    "tags": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 30 } },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "contract": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "config_keys": { "type": "array", "maxItems": 30, "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$" } },
        "requires": { "type": "array", "maxItems": 30, "items": { "type": "string", "pattern": "^[a-z][a-z_]*:.+$" } }
      }
    },
    "sandbox": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "scripts": { "type": "boolean" }, "forms": { "type": "boolean" }, "modals": { "type": "boolean" },
        "popups": { "type": "boolean" }, "downloads": { "type": "boolean" }, "sameOrigin": { "type": "boolean" }
      }
    },
    "config": { "type": "object" },
    "config_schema": {
      "type": "object", "additionalProperties": false, "required": ["namespace", "fields"],
      "description": "The tool's settings, declared so the bench can own them: a form in Settings, checks before a run, storage in the shared settings under namespace, injection as TOOL_CONFIG[namespace]. namespace must also be in contract.config_keys; paths are unique; enum fields list values; defaults match the type; secret fields carry no default. build.mjs checks what this dialect can't.",
      "properties": {
        "namespace": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$", "maxLength": 60 },
        "fields": {
          "type": "array", "minItems": 1, "maxItems": 50,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["path", "label", "type"],
            "properties": {
              "path": { "type": "string", "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$", "maxLength": 200, "description": "dot path inside the namespace; segments may hold '-' and capitals (dashboard.headers.X-Api-Key)" },
              "label": { "type": "string", "minLength": 1, "maxLength": 80 },
              "type": { "enum": ["url", "string", "header", "secret", "number", "boolean", "enum"] },
              "required": { "type": "boolean" },
              "default": { "description": "matches type; not allowed on secret fields" },
              "values": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "string", "maxLength": 80 } },
              "secret": { "type": "boolean", "description": "type secret implies it; secret values stay on the device, never exported or put in the registry" },
              "help": { "type": "string", "maxLength": 300 }
            }
          }
        }
      }
    },
    "url": { "type": "string", "pattern": "^https://" },
    "run": { "enum": ["link", "fetch"], "description": "How the bench runs a url tool: link (default) frames the url; fetch reads it (no credentials, X-CA-SHA256 checked when sent) and runs it inline like a file tool." }
  }
}
