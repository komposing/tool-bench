{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ca.repo/1/manifest",
  "title": "CA_V3 source repo manifest (ca.repo/1)",
  "description": "Vendored copy of the manifest schema in CA_standards row source_repo, version 2. The row is the source of truth; a change to it is copied here by the same change.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "repo",
    "key",
    "name",
    "version",
    "purpose",
    "owner",
    "lifecycle",
    "data_class",
    "criticality",
    "entry",
    "distribution",
    "depends",
    "governance",
    "releases"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "protocol": {
      "const": "ca.repo/1"
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$"
    },
    "key": {
      "type": "string",
      "pattern": "^repo:[A-Za-z0-9-]+/[A-Za-z0-9._-]+$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,59}$"
    },
    "title": {
      "type": "string",
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "purpose": {
      "type": "string",
      "minLength": 10,
      "maxLength": 400
    },
    "owner": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60
    },
    "lifecycle": {
      "enum": [
        "active",
        "deprecated",
        "retiring"
      ]
    },
    "data_class": {
      "enum": [
        "none",
        "internal",
        "pii",
        "secret"
      ]
    },
    "criticality": {
      "enum": [
        "page",
        "alert",
        "ignore"
      ]
    },
    "entry": {
      "type": "string",
      "maxLength": 200
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "asset",
        "latest",
        "record"
      ],
      "properties": {
        "channel": {
          "const": "github_release"
        },
        "asset": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$",
          "maxLength": 80
        },
        "latest": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9-]+/[A-Za-z0-9._-]+/releases/latest/download/[A-Za-z0-9._-]+$"
        },
        "record": {
          "type": "string",
          "maxLength": 120
        }
      }
    },
    "source": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 200
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "schema"
      ],
      "properties": {
        "key": {
          "type": "string",
          "maxLength": 80
        },
        "schema": {
          "type": "integer",
          "minimum": 1
        },
        "migrations": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "since",
              "keeps_source"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "since": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "keeps_source": {
                "const": true
              }
            }
          }
        }
      }
    },
    "provides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocols": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "detail"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,59}$"
              },
              "detail": {
                "type": "string",
                "maxLength": 300
              }
            }
          }
        }
      }
    },
    "depends": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ca"
      ],
      "properties": {
        "ca": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "why"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z_]*:.+$"
              },
              "why": {
                "type": "string",
                "maxLength": 200
              }
            }
          }
        },
        "tools": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "by"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z_]*:.+$"
              },
              "by": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "ca": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kinds_known": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z_]*$"
          }
        },
        "kinds_note": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "standard",
        "gate",
        "branch_pattern",
        "trailers"
      ],
      "properties": {
        "standard": {
          "const": "std:source_repo"
        },
        "gate": {
          "type": "string",
          "maxLength": 200
        },
        "branch_pattern": {
          "type": "string",
          "maxLength": 100
        },
        "trailers": {
          "type": "array",
          "minItems": 2,
          "items": {
            "enum": [
              "CA-Change",
              "CA-Session"
            ]
          }
        }
      }
    },
    "releases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "change"
        ],
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "change": {
            "type": "string",
            "pattern": "^C[0-9]{3,}$"
          },
          "note": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    }
  }
}
